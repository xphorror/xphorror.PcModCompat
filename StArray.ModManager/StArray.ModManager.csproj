<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StArray.ModManager</RootNamespace>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefineConstants Condition="'$(PcCompatRewrittenOracleDefault)' == 'true'">$(DefineConstants);STARRAY_PCMOD_COMPAT_REWRITTEN_ORACLE_DEFAULT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StArray.ModManager.SourceGenerator\StArray.ModManager.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\xphorror.PcModCompat\src\**\*.cs" LinkBase="xphorror.PcModCompat" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\fa-solid-900.ttf" />
    <EmbeddedResource Include="Resources\NotoSansCJK-Regular.otf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StArray.ModManager.Tests" />
  </ItemGroup>

</Project>
