<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0"/>
        <PackageReference Include="NUnit" Version="4.3.2"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.7.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup Condition="'$(SkipWindowsNativeTests)' == 'true'">
        <Compile Remove="HookTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StArray.ModManager.Windows\StArray.ModManager.Windows.csproj"
                          Condition="'$(SkipWindowsNativeTests)' != 'true'" />
        <ProjectReference Include="..\StArray.ModManager\StArray.ModManager.csproj" />
        <ProjectReference Include="..\StArray.ModManager.Android\StArray.ModManager.Android.csproj" />
        <!-- Harmony aggregation fixtures annotate themselves with the real shim attributes, so the
             reference is explicit instead of transitive through JALib. -->
        <ProjectReference Include="..\xphorror.PcModCompat\shims\0Harmony\0Harmony.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\shims\JALib\JALib.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\shims\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" />
        <!-- The render-component fixtures declare a stand-in that derives the real MaskableGraphic and
             overrides OnPopulateMesh(VertexHelper), because the render component registry matches on
             the exact type name and offers no test injection seam. -->
        <ProjectReference Include="..\xphorror.PcModCompat\shims\UnityEngine.UI\UnityEngine.UI.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\tools\ModAssemblyRewriter\ModAssemblyRewriter.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\tools\CilSemanticPack\CilSemanticPack.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\tools\ProxySurfaceScanner\ProxySurfaceScanner.csproj" />
        <ProjectReference Include="..\xphorror.PcModCompat\Resources\xphorror.PcModCompat.Resources.csproj" />
        <ProjectReference Include="..\StArray.ModManager.SourceGenerator\StArray.ModManager.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- ─── GCC 编译 test_native.c → test_native.dll ─── -->
    <Target Name="BuildNativeTestDll" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeTestDll)' != 'true'">
        <PropertyGroup>
            <NativeSource>$(MSBuildProjectDirectory)\native\test_native.c</NativeSource>
            <NativeOutput>$(OutputPath)test_native.dll</NativeOutput>
            <_Gcc>gcc</_Gcc>
        </PropertyGroup>
        <Exec Command="&quot;$(_Gcc)&quot; -shared -O2 -Wall -Werror -o &quot;$(NativeOutput)&quot; &quot;$(NativeSource)&quot;"
              ConsoleToMSBuild="true" />
        <Message Text="test_native.dll compiled" Importance="high" />
    </Target>

</Project>
