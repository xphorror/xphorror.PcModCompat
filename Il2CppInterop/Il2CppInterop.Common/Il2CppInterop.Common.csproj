<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>BepInEx, knah et al.</Authors>
    <Description>Common API for Il2CppInterop packages</Description>
    <RootNamespace>Il2CppInterop.Common</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Il2CppInteropAndroidSlim)' == 'true'">
    <DefineConstants>$(DefineConstants);IL2CPPINTEROP_ANDROID_SLIM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1"/>
    <PackageReference Include="System.Net.Http" Version="4.3.4"/>
  </ItemGroup>

  <ItemGroup Condition="'$(Il2CppInteropAndroidSlim)' != 'true'">
    <PackageReference Include="Iced" Version="1.17.0"/>
  </ItemGroup>

  <ItemGroup Condition="'$(Il2CppInteropAndroidSlim)' == 'true'">
    <Compile Remove="XrefScans\XrefScanner.cs" />
    <Compile Remove="XrefScans\XrefScannerLowLevel.cs" />
    <Compile Remove="XrefScans\XrefScanUtilFinder.cs" />
  </ItemGroup>

</Project>
