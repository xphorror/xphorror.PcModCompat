<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StArray.ModManager.Android</RootNamespace>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StArray.ModManager\StArray.ModManager.csproj" />
    <ProjectReference Include="..\Il2CppInterop\Il2CppInterop.Runtime\Il2CppInterop.Runtime.csproj" />
    <ProjectReference Include="..\xphorror.PcModCompat\tools\ModAssemblyRewriter\ModAssemblyRewriter.csproj" />
    <ProjectReference Include="..\xphorror.PcModCompat\Resources\xphorror.PcModCompat.Resources.csproj" />
    <ProjectReference Include="..\StArray.ModManager.SourceGenerator\StArray.ModManager.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StArray.ModManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\Il2CppInterop\Il2CppInterop.Runtime\Libs\Il2Cppmscorlib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
  </ItemGroup>

</Project>
